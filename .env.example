# Fork-test RPC (public Ethereum-mainnet read endpoint — no secret required).
# Copy to `.env` (gitignored) or export in your shell. If unset, test/fork/* falls back
# in-code to this same public endpoint, so `forge test --match-path 'test/fork/*'` works out of the box.
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# Optional. Only used if you enable Etherscan verification; source identity in this repo is
# established via Sourcify (see deployment-evidence.json), so this can stay blank.
ETHERSCAN_API_KEY=
